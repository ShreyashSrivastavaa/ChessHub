# ==============================================================================
# Chess Hub — Environment Configuration Template (.env.example)
# ==============================================================================

# Database Connection
# Local Development: SQLite
# Production (Vercel / Neon / Supabase): PostgreSQL connection string
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for Vercel/Neon:
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication & Sessions
# Generate with `openssl rand -base64 32` or at least 32 characters
AUTH_SECRET="chess-hub-production-auth-secret-min-32-characters-change-me"
NEXT_PUBLIC_APP_URL="https://chess-hub-six.vercel.app"

# Timezone Configuration (Default: Asia/Kolkata)
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# Optional Seed Credentials (Used when running `npm run db:seed` or `npm run admin:create`)
ADMIN_EMAIL="admin@chesshub.in"
ADMIN_PASSWORD="ReplaceWithSecureAdminPassword123!"

# Email Notifications (Optional via Resend)
# If left empty, booking notifications are safely logged to console in dev and booking still succeeds.
# If configured, sends student acknowledgement ("request received") and admin alerts.
RESEND_API_KEY=""
EMAIL_FROM="Chess Hub <shreyashsr2004@gmail.com>"
