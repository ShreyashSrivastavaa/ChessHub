# Database Connection (SQLite by default for zero-setup local dev, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/tworooks?schema=public"

# Auth Secrets
AUTH_SECRET="two-rooks-super-secret-jwt-key-change-in-production-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Provider ("mock" for local development & testing, "razorpay" for production)
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Email Provider (Optional: if empty or development, notifications log to console)
RESEND_API_KEY=""
EMAIL_FROM="Two Rooks <notifications@tworooks.com>"

# Optional Demo Data Seeding (Set to "true" to seed a student with class history & progress)
SEED_DEMO="true"
