datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("ADMIN")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Coach {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  displayName String
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots    Slot[]
  bookings Booking[]
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime   String   // "10:00" (HH:mm)
  endTime     String   // "18:00" (HH:mm)
  duration    Int      @default(60) // slot duration in minutes
  capacity    Int      @default(1)
  coachSlug   String?  // "shreyash" | "tapesnu" | null (applies to academy)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dayOfWeek, isActive])
}

model AvailabilityDate {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD"
  isBlocked Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Slot {
  id              String   @id @default(cuid())
  date            String   // "YYYY-MM-DD" in Asia/Kolkata
  startTime       String   // "10:00"
  endTime         String   // "11:00"
  startsAt        DateTime // UTC
  endsAt          DateTime // UTC
  durationMinutes Int      @default(60)
  capacity        Int      @default(1)
  isBlocked       Boolean  @default(false)
  isSoldOut       Boolean  @default(false)
  coachId         String?
  coach           Coach?   @relation(fields: [coachId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]

  @@unique([date, startTime])
  @@index([date])
  @@index([startsAt])
  @@index([isBlocked, isSoldOut])
}

model Booking {
  id             String         @id @default(cuid())
  reference      String         @unique // Human-friendly e.g. "CH-7X8K2M"
  idempotencyKey String?        @unique
  fullName       String
  email          String
  phone          String
  level          String         // "beginner" | "advanced"
  priceRupees    Int            // 500 or 800
  currency       String         @default("INR")
  date           String         // "YYYY-MM-DD"
  timeSlot       String         // "10:00"
  startsAt       DateTime       // UTC
  endsAt         DateTime       // UTC
  status         String         @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  message        String?
  adminNotes     String?
  slotId         String?
  slot           Slot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)
  coachId        String?
  coach          Coach?         @relation(fields: [coachId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events BookingEvent[]

  @@index([status])
  @@index([date])
  @@index([email])
  @@index([startsAt])
  @@index([reference])
}

model BookingEvent {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  eventType   String   // "CREATED" | "CONFIRMED" | "CANCELLED" | "COMPLETED" | "RESCHEDULED" | "NOTE_UPDATED"
  performedBy String   // "STUDENT" | "ADMIN" | "SYSTEM"
  details     String?
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([action])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([key, expiresAt])
}
